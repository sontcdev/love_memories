# [DEVELOPMENT PROFILE]
# Database connections (Supabase - Pooling enabled)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Không còn Supabase database? Có thể dùng PostgreSQL local qua Docker bằng
# cách thay 2 URL phía trên bằng URL dưới đây và bỏ comment các dòng này.
# `./start.sh` sẽ tự tạo/start container; cổng 55432 tránh xung đột PostgreSQL khác.
# DATABASE_URL="postgresql://love_memories:love_memories_dev@127.0.0.1:55432/love_memories?schema=public"
# DIRECT_URL="postgresql://love_memories:love_memories_dev@127.0.0.1:55432/love_memories?schema=public"
# LOCAL_POSTGRES_DOCKER="true"
# LOCAL_POSTGRES_CONTAINER="love-memories-postgres"
# LOCAL_POSTGRES_IMAGE="postgres:16.14-alpine"
# LOCAL_POSTGRES_PORT="55432"
# LOCAL_POSTGRES_USER="love_memories"
# LOCAL_POSTGRES_PASSWORD="love_memories_dev"
# LOCAL_POSTGRES_DB="love_memories"

# Supabase Storage & Client API (Development Bucket/Project)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
